#!/bin/sh

VERSION="3.0.0"
ZA_CACHE_DIR="${XDG_CACHE_HOME:-"$HOME"/.cache}/zaread"

# Default converters
: "${ZA_MOBI_CMD:=ebook-convert}"
: "${ZA_OFFICE_CMD:=soffice}"
: "${ZA_MD_CMD:=md2pdf}"
: "${ZA_TYPST_CMD:=typst}"

: "${ZA_TYPST_ARG:=compile --format pdf}"
: "${ZA_MD_ARG:=}"
: "${ZA_MOBI_ARG:=}"
: "${ZA_OFFICE_ARG:=}"

: "${ZA_VERBOSE:=0}"
: "${ZA_FORCE:=0}"

log() {
	[ "$ZA_VERBOSE" -eq 1 ] && echo "$1" >&2
}

err() {
	echo "zaread: $1" >&2
}

usage() {
	echo "Usage: zaread -t <type> [-v] [-f] [-c] [-V] [-h]"
}

# Run a converter that writes to a .part temp file, handle errors, rename on success.
# Usage: run_convert <display_name> <cmd> [args...]
run_convert() {
	_name="$1"; shift
	if ! "$@"; then
		rm -f "$ZA_CACHE_DIR/$pdffile.part"
		err "conversion failed: $_name $file"
		exit 3
	fi
	mv "$ZA_CACHE_DIR/$pdffile.part" "$ZA_CACHE_DIR/$pdffile"
}


while getopts ":vhcVFt:" opt; do
	case "$opt" in
	v) ZA_VERBOSE=1 ;;
	f) ZA_FORCE=1 ;;
	c)
		if [ -d "$ZA_CACHE_DIR" ]; then
			rm -rf "${ZA_CACHE_DIR:?}"/*
			echo "Cache cleared: $ZA_CACHE_DIR"
		else
			echo "No cache directory found."
		fi
		exit 0
		;;
	V)
		echo "zaread $VERSION"
		exit 0
		;;
	h) usage; exit 0 ;;
	t) ZA_FT="$OPTARG" ;;
	*) err "unknown option: -$OPTARG"; usage >&2; exit 1 ;;
	esac
done
shift $((OPTIND - 1))

if [ "$#" -ne 0 ]; then
	err "unexpected argument(s): $#"
	usage >&2
	exit 1
fi

if [ -t 0 ]; then
	err "no stdin provided"
	usage >&2
	exit 1
fi

if [ -z "$ZA_FT" ]; then
	err "file type not specified (use -t <ext>)"
	usage >&2
	exit 1
fi

# Create cache dir if needed (deferred so -V/-h/-c don't create it as a side effect)
[ -d "$ZA_CACHE_DIR" ] || mkdir -p "$ZA_CACHE_DIR" || { err "cannot create cache directory: $ZA_CACHE_DIR"; exit 1; }

# Read stdin to a temp file
tmpfile="/tmp/zaread-$$.$ZA_FT"
cat > "$tmpfile" || { err "failed to read stdin"; exit 1; }

# Clean up temp file on exit
trap 'rm -f "$tmpfile"' EXIT

file="$(basename "$tmpfile")"
log "File: $file"

directory="$(dirname "$tmpfile")"
log "Directory: $directory"

# Cache key: CRC_BYTECOUNT.pdf
_ckout="$(cksum "$tmpfile")"
_crc="${_ckout%% *}"; _rest="${_ckout#* }"
_bytes="${_rest%% *}"
pdffile="${_crc}_${_bytes}.pdf"
log "Cache file: $pdffile"

file_converter=""

# Determine file_converter from the file extension passed via -t
case "$ZA_FT" in
	pdf)
		file_converter="none_original"
		;;
	mobi|epub)
		file_converter="$ZA_MOBI_CMD"
		;;
	md)
		file_converter="$ZA_MD_CMD"
		;;
	typ)
		file_converter="$ZA_TYPST_CMD"
		;;
	docx|xlsx|pptx|docm|pptm|xlsm|xlsb|doc|xls|ppt|odt|ods|odp|rtf|csv)
		file_converter="$ZA_OFFICE_CMD"
		;;
	*)
		err "unsupported format: $ZA_FT"
		exit 2
		;;
	esac

	# Use cache if available and not forced
	if [ -f "$ZA_CACHE_DIR/$pdffile" ] && [ "$ZA_FORCE" -eq 0 ]; then
		file_converter="none_converted"
	fi

	case "$file_converter" in
"none_original")
	log "Outputting original PDF"
	cat "$tmpfile"
	;;
"none_converted")
	log "Outputting from cache"
	cat "$ZA_CACHE_DIR/$pdffile"
	;;
*)
	if ! command -v "$file_converter" >/dev/null; then
		err "$file_converter is not in PATH (needed to convert $file)"
		exit 1
	fi
	log "Converting $file with $file_converter"
	# _ARG vars intentionally unquoted to allow multi-argument values
	case "$file_converter" in
	"$ZA_OFFICE_CMD")
		# shellcheck disable=SC2086
		if ! "$ZA_OFFICE_CMD" $ZA_OFFICE_ARG \
			"-env:UserInstallation=file:///tmp/zaread-soffice-$$" \
			--convert-to pdf "$tmpfile" --outdir "$ZA_CACHE_DIR"; then
			rm -f "$ZA_CACHE_DIR/$pdffile.part"
			rm -rf "/tmp/zaread-soffice-$$"
			err "conversion failed: $ZA_OFFICE_CMD $file"
			exit 3
		fi
		rm -rf "/tmp/zaread-soffice-$$"
		filebase="${file%.*}"
		mv "$ZA_CACHE_DIR/$filebase.pdf" "$ZA_CACHE_DIR/$pdffile"
		;;
	"$ZA_MOBI_CMD")
		# shellcheck disable=SC2086
		run_convert "$ZA_MOBI_CMD" "$ZA_MOBI_CMD" $ZA_MOBI_ARG "$tmpfile" "$ZA_CACHE_DIR/$pdffile.part"
		;;
	"$ZA_MD_CMD")
		# shellcheck disable=SC2086
		run_convert "$ZA_MD_CMD" "$ZA_MD_CMD" $ZA_MD_ARG -i "$tmpfile" -o "$ZA_CACHE_DIR/$pdffile.part"
		;;
	"$ZA_TYPST_CMD")
		# shellcheck disable=SC2086
		run_convert "$ZA_TYPST_CMD" "$ZA_TYPST_CMD" $ZA_TYPST_ARG "$tmpfile" "$ZA_CACHE_DIR/$pdffile.part"
		;;
	esac
	log "Outputting converted file"
	cat "$ZA_CACHE_DIR/$pdffile"
	;;
esac
